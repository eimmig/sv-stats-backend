# Copie para .env (nunca versionado - ver .gitignore) e preencha os valores reais.
# Ver docs/OBSERVABILITY-AND-CONFIG.md. So variaveis que algum codigo deste servico realmente
# le - cada bloco abaixo documenta a feature que a introduziu.

# Conexao Postgres (perfil dev - ver src/main/resources/application.yml).
# DB_HOST/DB_PORT/DB_NAME/DB_USER tem default para o container local (infra/docker-compose.yml,
# postgres-stats) - so precisam ser sobrescritos se o ambiente for diferente do padrao.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stats
DB_USER=stats_user
DB_PASSWORD=CHANGE_ME

# Segredo estatico do header X-Admin-Api-Key (rota administrativa de provisionamento de
# tenant, feat-001.4) - uso exclusivo do operador da plataforma, ver docs/API-CONTRACTS.md.
ADMIN_API_KEY=CHANGE_ME

# Conexao RabbitMQ (perfil dev - feat-001.9, consumo dos eventos BetCreated/BetSettled).
# Default para o container local (infra/docker-compose.yml, rabbitmq).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# Conexao Redis (perfil dev - feat-005, cache-aside com invalidacao no consumo do evento).
# Default para o container local (infra/docker-compose.yml, redis).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
